<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ClefCompilerProject Condition="'$(ClefCompilerProject)' == ''">$(MSBuildThisFileDirectory)../../../clef/src/Compiler/Clef.Compiler.Service.fsproj</ClefCompilerProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <ProjectReference Include="../../src/Farscape.Core/Farscape.Core.fsproj" />
    <ProjectReference Include="$(ClefCompilerProject)" />
  </ItemGroup>
</Project>
