<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Fidelity.Farscape</PackageId>
    <Description>F# bindings generator for C/C++ headers, part of the Fidelity native compilation ecosystem. Uses XParsec parser combinators, active patterns, catamorphisms, and a typed code AST.</Description>
    <PackageTags>fsharp;f#;bindings;codegen;native;fidelity;xparsec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="CppParser.fs" />
    <Compile Include="TypeMapper.fs" />
    <Compile Include="CTypeParser.fs" />
    <Compile Include="ActivePatterns.fs" />
    <Compile Include="PilotTypes.fs" />
    <Compile Include="DeclarationAlgebra.fs" />
    <Compile Include="PilotAnalyzer.fs" />
    <Compile Include="PilotDiscovery.fs" />
    <Compile Include="PilotSerializer.fs" />
    <Compile Include="WaylandProtocolParser.fs" />
    <Compile Include="WrapperTypes.fs" />
    <Compile Include="WrapperPatternAnalyzer.fs" />
    <Compile Include="CodeAST.fs" />
    <Compile Include="CodeRenderer.fs" />
    <Compile Include="FidelityCodeGenerator.fs" />
    <Compile Include="WrapperCodeGenerator.fs" />
    <Compile Include="ErrnoModuleGenerator.fs" />
    <Compile Include="EnumErrorModuleGenerator.fs" />
    <Compile Include="CallbackWrapperGenerator.fs" />
    <Compile Include="DescriptorGenerator.fs" />
    <Compile Include="BindingGenerator.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Data" Version="6.6.0" />
    <ProjectReference Include="../../../Fidelity.Data/src/Fidelity.Data/Fidelity.Data.fsproj" />
  </ItemGroup>

  <!-- XParsec: NuGet for packaging, local project ref for dev override -->
  <ItemGroup Condition="'$(UseFarscapeLocalDeps)' != 'true'">
    <PackageReference Include="XParsec" Version="0.3.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseFarscapeLocalDeps)' == 'true'">
    <ProjectReference Include="../../../XParsec/src/XParsec/XParsec.fsproj" />
  </ItemGroup>

</Project>
