<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>farscape</ToolCommandName>
    <PackageId>Farscape</PackageId>
    <Description>F# native binding generator CLI: generates F# bindings from C/C++ headers for the Fidelity ecosystem</Description>
    <PackageTags>fsharp;f#;bindings;codegen;native;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farscape.Core\Farscape.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EluciusFTW.SpectreCoff" Version="0.50.7" />
    <PackageReference Include="FSharp.SystemCommandLine" Version="2.1.0" />
    <!-- Pin to fix GHSA-rxmq-m78w-7wmc (transitive from SpectreCoff) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
